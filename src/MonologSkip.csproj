<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>13</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>../mod/newest/plugins</OutputPath>
		<PathMap>$(MSBuildProjectDirectory)=/$(SolutionName)</PathMap>
	</PropertyGroup>

	<PropertyGroup>
		<SteamPath>$([MSBuild]::GetRegistryValue('HKEY_CURRENT_USER\Software\Valve\Steam', 'SteamPath'))</SteamPath>
		<LibraryFoldersVdf>$(SteamPath)\config\libraryfolders.vdf</LibraryFoldersVdf>
		<LibraryFoldersContent>$([System.IO.File]::ReadAllText('$(LibraryFoldersVdf)'))</LibraryFoldersContent>
		<RWLibrary>$([System.Text.RegularExpressions.Regex]::Match('$(LibraryFoldersContent)', '(?s)"\d+"\s*\{(?:(?!\n\s*"\d+"\s*\{).)*?"path"\s*"([^"]+)"(?:(?!\n\s*"\d+"\s*\{).)*?"312520"').Groups[1].Value.Replace('\\','\'))</RWLibrary>
		<RainWorldDir>$(RWLibrary)\steamapps\common\Rain World</RainWorldDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="PolySharp" Version="1.15.0">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="BepInEx">
	    <HintPath>$(RainWorldDir)\BepInEx\core\BepInEx.dll</HintPath>
	  </Reference>
	  <Reference Include="HOOKS-Assembly-CSharp">
	    <HintPath>$(RainWorldDir)\BepInEx\plugins\HOOKS-Assembly-CSharp.dll</HintPath>
	  </Reference>
	  <Reference Include="ImprovedInput">
	    <HintPath>$(RWLibrary)\steamapps\workshop\content\312520\3458119961\plugins\ImprovedInput.dll</HintPath>
	  </Reference>
	  <Reference Include="Assembly-CSharp">
	    <HintPath>$(RainWorldDir)\BepInEx\utils\PUBLIC-Assembly-CSharp.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine">
	    <HintPath>$(RainWorldDir)\RainWorld_Data\Managed\UnityEngine.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.CoreModule">
	    <HintPath>$(RainWorldDir)\RainWorld_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
	  </Reference>
	</ItemGroup>
</Project>